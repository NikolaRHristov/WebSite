---
import Heading from "@Component/Readme/Heading.astro";
import Row from "@Component/Readme/Row.astro";
import Table from "@Component/Readme/Table.astro";

const { Open } = Astro.props;
---

<>
	<Table {Open}>
		<Heading
			DarkIcon="https://PlayForm.Cloud/Dark/Image/GitHub/Land.svg"
			LightIcon="https://PlayForm.Cloud/Image/GitHub/Land.svg"
			Text="Land"
		/>

		<Row
			Package={new Set([
				"GitHub:CodeEditorLand/Air",
				"GitHub:CodeEditorLand/Cocoon",
				"GitHub:CodeEditorLand/Common",
				"GitHub:CodeEditorLand/Echo",
				"GitHub:CodeEditorLand/Grove",
				"GitHub:CodeEditorLand/Maintain",
				"GitHub:CodeEditorLand/Mist",
				"GitHub:CodeEditorLand/Mountain",
				"GitHub:CodeEditorLand/Output",
				"GitHub:CodeEditorLand/Rest",
				"GitHub:CodeEditorLand/SideCar",
				"GitHub:CodeEditorLand/Sky",
				"GitHub:CodeEditorLand/Vine",
				"GitHub:CodeEditorLand/Wind",
				"GitHub:CodeEditorLand/Worker",

				"GitHub:CodeEditorLand/Land",
				"GitHub:CodeEditorLand/Editor",
				"GitHub:CodeEditorLand/Element",
			])}
		/>
	</Table>
</>
