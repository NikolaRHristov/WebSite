---
import Land from "@Component/Readme/CodeEditorLand/Land.astro";
import Table from "@Component/Readme/Table.astro";

const Readme = (
	await import("@Page/Raw/Readme/CodeEditorLand/Land/README.md")
).rawContent();
---

<html>
	<head></head>
	<body>
		<Table>
			<Land Open={true} />
		</Table>

		<hr />

		<Fragment set:html={Readme} />
	</body>
</html>
